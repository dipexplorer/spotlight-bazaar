# Supabase Public Keys (Client side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (Server side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDFLARE_CACHE_TTL=120

# MapTiler API Key (Optional — photorealistic satellite imagery & 3D Terrain-RGB; falls back to Esri World Imagery when omitted)
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-api-key

